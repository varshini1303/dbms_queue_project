# Environment Configuration
PORT=8000
HOST=0.0.0.0

# Public or Local Backend URL (used by clients to connect)
BACKEND_URL=http://127.0.0.1:8000

# Database URL (defaults to local SQLite if omitted)
# For Postgres: postgresql://user:password@hostname:5432/bank_queue
DATABASE_URL=sqlite:///bank_queue.db

# JWT Security
SECRET_KEY=bank_queue_secure_jwt_secret_key_change_in_production

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=https://queue-wiz-home.lovable.app,http://localhost:5173,http://localhost:3000
